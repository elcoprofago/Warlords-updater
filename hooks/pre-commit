#!/bin/sh
# Se activa una vez por clon:  git config core.hooksPath hooks
#
# 1) BLOQUEA: cambios en parches/<ID>/ sin cambiar la VERSION de <ID> en parches/parches.txt
#    en el mismo commit. El actualizador decide "hay version nueva" por ese numero; si el codigo
#    cambia y el numero no, los jugadores que ya lo tienen nunca ven la actualizacion.
#    No cuentan los *.md ni los prueba*.py (no cambian lo que se publica).
# 2) RECUERDA (no bloquea): un cambio en source/ no le llega a nadie hasta recompilar
#    el exe con tools/compilar-actualizador.ps1 y
#    publicarlo; git no puede verificar ese paso.
# 3) BLOQUEA: cambiar lo que la opcion 6 no pisa (NoPisar, RaizPropia, DataPropia en
#    source/Actualizador/Actualizador.cs) sin cambiar tools/publicar-full.ps1 en el mismo commit:
#    lo que no se pisa en ninguna PC tampoco tiene que salir en el zip de quien lo arma.
# 5) RECUERDA (no bloquea): el titulo de la ventana de cierre de DarkCompare (DC_CLOSE_TITLE en
#    parches/vista-aliada/build.py) es un contrato con el repo DarkCompare (TituloCierre en Program.cs):
#    si cambia aca y no alla, el Comparador abierto desde el libro deja de cerrarse al empezar el turno.
# 4) BLOQUEA: un archivo que sale de ARCHIVOS de vista-aliada en parches/parches.txt (un bono renombrado
#    o quitado) sin estar en OBSOLETOS de parches/vista-aliada/build.py: el Actualizador no borra nada,
#    y la copia vieja quedaria en las PC que ya lo tenian (DarklordAV.exe borra los OBSOLETOS al arrancar).
# 6) BLOQUEA: una VERSION nueva de vista-aliada en parches/parches.txt sin, en el mismo commit,
#    (a) manual/manual.html con esa version en el Apendice E (Historial de versiones) y
#    (b) manual/Manual-Era-de-Alianzas.pdf regenerado (python manual/build_manual.py).
#    Regla del usuario (11/11/2026): cada cambio se refleja en los registros del repo y en el
#    manual del parche; el PDF va dentro del parche.
# 7) BLOQUEA: TAREAS.md con (a) dos tareas con el mismo numero o (b) el encabezado ("hoy, la N")
#    distinto del numero mas alto + 1. Regla global 15: numeracion correlativa y fija, para que
#    "la 190" sea una sola tarea (el 13/11/2026 hubo dos 190, una de la IA y otra del Simulador).

version_de() {  # stdin: parches.txt; $1: ID
    tr -d '\r' | grep -v '^#' | awk -F'|' -v id="$1" '$1 == id { print $2 }'
}

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
fallo=0

ids=$(printf '%s\n' "$staged" | grep -v -e '\.md$' -e '/prueba[^/]*\.py$' |
      sed -n 's#^parches/\([^/]*\)/.*#\1#p' | sort -u)
for id in $ids; do
    antes=$(git show HEAD:parches/parches.txt 2>/dev/null | version_de "$id")
    ahora=$(git show :parches/parches.txt 2>/dev/null | version_de "$id")
    if [ -z "$ahora" ]; then
        echo "pre-commit: cambia parches/$id/ pero '$id' no esta en parches/parches.txt." >&2
        fallo=1
    elif [ "$antes" = "$ahora" ]; then
        echo "pre-commit: cambia parches/$id/ y su VERSION sigue en $ahora." >&2
        echo "            Subila en parches/parches.txt en este mismo commit." >&2
        fallo=1
    fi
done

if printf '%s\n' "$staged" | grep -q -e '^source/'; then
    cat >&2 <<'EOF'
pre-commit (recordatorio): cambiaste source/ (va dentro del exe).
  Para que llegue a los jugadores:
  1. subir Version, FileVersion y AssemblyVersion en source/Actualizador/Actualizador.csproj,
  2. git push y despues .\tools\compilar-actualizador.ps1 -Publicar
     (compila, prueba y sube el exe a la release "Ejecutable" de GitHub).
EOF
fi

bloque_nopisar() {  # stdin: Actualizador.cs; desde RaizPropia hasta el final de NoPisar
    tr -d '\r' | sed -n '/HashSet<string> RaizPropia/,/EnCarpeta(rel, "CAMPAIGN"/p'
}
if [ "$(git show HEAD:source/Actualizador/Actualizador.cs 2>/dev/null | bloque_nopisar)" != \
     "$(git show :source/Actualizador/Actualizador.cs 2>/dev/null | bloque_nopisar)" ] &&
   ! printf '%s\n' "$staged" | grep -q -x 'tools/publicar-full.ps1'; then
    echo "pre-commit: cambia lo que la opcion 6 no pisa (NoPisar en Actualizador.cs) y tools/publicar-full.ps1 no." >&2
    echo "            Actualiza Incluir en publicar-full.ps1 en este mismo commit." >&2
    fallo=1
fi

archivos_av() {  # stdin: parches.txt; un archivo por linea
    tr -d '\r' | grep -v '^#' | awk -F'|' '$1 == "vista-aliada" { print $3 }' | tr ';' '\n' | sort -u
}
obsoletos=$(git show :parches/vista-aliada/build.py 2>/dev/null | tr -d '\r' | sed -n 's/^OBSOLETOS = //p')
antes_av=$(mktemp); ahora_av=$(mktemp)
git show HEAD:parches/parches.txt 2>/dev/null | archivos_av > "$antes_av"
git show :parches/parches.txt 2>/dev/null | archivos_av > "$ahora_av"
salen=$(comm -23 "$antes_av" "$ahora_av"); rm -f "$antes_av" "$ahora_av"
for f in $salen; do
    # Un nombre con caracteres de control no puede existir en Windows: es una errata de parches.txt, no un archivo
    # que haya quedado en alguna PC (caso: "RUINS\aviso.pcx" escrito con \a = BEL, 30/10/2026).
    if printf '%s' "$f" | LC_ALL=C grep -q '[[:cntrl:]]'; then continue; fi
    case "$obsoletos" in
        *"'$f'"*) ;;
        *) echo "pre-commit: $f sale del parche vista-aliada y no esta en OBSOLETOS de build.py." >&2
           echo "            Agregalo ahi: DarklordAV.exe lo borra al arrancar en las PC que ya lo tienen." >&2
           fallo=1 ;;
    esac
done

if git diff --cached -- parches/vista-aliada/build.py | grep -q '^[-+].*DC_CLOSE_TITLE'; then
    echo "pre-commit (recordatorio): cambiaste DC_CLOSE_TITLE en build.py: el mismo titulo tiene que estar en" >&2
    echo "  TituloCierre de DarkCompare (Program.cs), y DarkCompare publicado con ese cambio." >&2
fi

av_antes=$(git show HEAD:parches/parches.txt 2>/dev/null | version_de vista-aliada)
av_ahora=$(git show :parches/parches.txt 2>/dev/null | version_de vista-aliada)
if [ -n "$av_ahora" ] && [ "$av_antes" != "$av_ahora" ]; then
    if ! git show :manual/manual.html 2>/dev/null | sed -n '/Historial de versiones<\/h1>/,$p' |
         grep -q "<td>$av_ahora</td>"; then
        echo "pre-commit: vista-aliada pasa a $av_ahora y el Manual no lo registra." >&2
        echo "            Agrega su fila arriba en el Apendice E de manual/manual.html (y, si el cambio" >&2
        echo "            se ve en el juego, explicalo en su capitulo)." >&2
        fallo=1
    fi
    if ! printf '%s\n' "$staged" | grep -q -x 'manual/Manual-Era-de-Alianzas.pdf'; then
        echo "pre-commit: vista-aliada pasa a $av_ahora sin regenerar el PDF del Manual." >&2
        echo "            Corre python manual\build_manual.py y agrega el PDF a este commit." >&2
        fallo=1
    fi
fi

if printf '%s\n' "$staged" | grep -qx 'TAREAS.md'; then
    tareas=$(git show :TAREAS.md | tr -d '\r')
    nums=$(printf '%s\n' "$tareas" | sed -n 's/^- \[[ xX]\] \*\*\([0-9][0-9]*\)\.\*\*.*/\1/p' | sort -n)
    dup=$(printf '%s\n' "$nums" | uniq -d | tr '\n' ' ')
    if [ -n "$dup" ]; then
        echo "pre-commit: TAREAS.md tiene numeros repetidos: $dup- darle a una el siguiente libre." >&2
        fallo=1
    fi
    max=$(printf '%s\n' "$nums" | tail -1)
    prox=$(printf '%s\n' "$tareas" | sed -n 's/.*(hoy, la \([0-9][0-9]*\)).*/\1/p' | head -1)
    if [ -n "$max" ] && [ "$prox" != "$((max + 1))" ]; then
        echo "pre-commit: TAREAS.md dice que la proxima es la '$prox', pero la mas alta es la $max (tiene que decir 'hoy, la $((max + 1))')." >&2
        fallo=1
    fi
fi

exit $fallo
